# http:// 또는 https:// 없이 실제 도메인만 적습니다.
SITE_DOMAIN=example.com
TLS_CONTACT_EMAIL=owner@example.com
SITE_CONTACT_EMAIL=owner@example.com

# AWS RDS MySQL endpoint를 넣습니다. http:// 또는 https://를 붙이지 않습니다.
DB_URL=jdbc:mysql://YOUR_RDS_ENDPOINT:3306/starrail_hearing?serverTimezone=UTC&characterEncoding=UTF-8&sslMode=REQUIRED
DB_USERNAME=starrail_app
DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Google Cloud Console의 OAuth 웹 클라이언트 값입니다.
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
APP_ADMIN_SUBJECT=YOUR_STABLE_GOOGLE_SUB

# 칭호 등급/색상과 신청 가능 버전은 코드와 game_version 데이터에서 관리합니다.
# 신규 게임 버전마다 환경변수를 수정할 필요가 없습니다.

# 실제 연락 가능한 이메일 또는 사이트 주소를 적습니다.
MIHOMO_USER_AGENT="StarrailHearing/1.0 contact=YOUR_CONTACT"
ENKA_USER_AGENT="StarrailHearing/1.0 contact=YOUR_CONTACT"

# Enka 운영 제한. 코드 재빌드 없이 이 값들을 바꾸고 app 컨테이너만 재시작해 조정할 수 있습니다.
ENKA_CONNECT_TIMEOUT=3s
ENKA_READ_TIMEOUT=15s
ENKA_CACHE_DEFAULT_TTL=60s
ENKA_CACHE_MAXIMUM_TTL=24h
ENKA_CACHE_MAX_ENTRIES=5000
ENKA_MAX_REQUESTS_PER_SECOND=2
ENKA_MAX_CONCURRENT_REQUESTS=8
ENKA_MAX_WAITING_REQUESTS=30
ENKA_REQUEST_WAIT_TIMEOUT=15s
ENKA_BACKOFF_ON_429=30s

# Caddy HTTPS 프록시 뒤에서 사용하는 운영값입니다.
SERVER_FORWARD_HEADERS_STRATEGY=framework
SERVER_SERVLET_SESSION_COOKIE_SECURE=true
SPRING_THYMELEAF_CACHE=true
