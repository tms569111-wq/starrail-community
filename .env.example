DB_URL=jdbc:mysql://localhost:3306/starrail_hearing?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=oracle_app
DB_PASSWORD=change-this-password
MYSQL_ROOT_PASSWORD=change-root-password
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
APP_ADMIN_SUBJECT=your-stable-google-sub

APP_PLATINUM_VERSION=4.4
APP_PLATINUM_LABEL="이상중재 PLATINUM"
APP_PLATINUM_COLOR="#8DE9FF"
MIHOMO_USER_AGENT="StarrailHearing/0.1 contact=your-contact"
ENKA_USER_AGENT="StarrailHearing/0.1 contact=your-contact"
PROFILE_REDIS_CACHE_ENABLED=false
PROFILE_MAX_CONCURRENT_REQUESTS=4
PROFILE_PROVIDER_MIN_INTERVAL=1s
PROFILE_PROVIDER_RATE_WAIT=4s
PROFILE_CACHE_MAX_ENTRIES=1000
PROFILE_CACHE_MAX_TTL=24h
TITLE_PRIVATE_UPLOAD_DIR=./private-uploads/title-verification

# 로컬 HTTP에서는 아래 기본값을 사용합니다.
# HTTPS 프록시 뒤에 배포할 때는 각각 framework, true로 변경하세요.
SERVER_FORWARD_HEADERS_STRATEGY=none
SERVER_SERVLET_SESSION_COOKIE_SECURE=false
SPRING_THYMELEAF_CACHE=true
