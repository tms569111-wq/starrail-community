DB_URL=jdbc:mysql://localhost:3306/starrail_hearing?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=oracle_app
DB_PASSWORD=change-this-password
MYSQL_ROOT_PASSWORD=change-root-password

# DB 연결과 쿼리 상한
DB_POOL_MAXIMUM_SIZE=10
DB_POOL_MINIMUM_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=3000
DB_QUERY_TIMEOUT_MS=10000

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
APP_ADMIN_SUBJECT=your-stable-google-sub

# 칭호 등급/색상과 신청 가능 버전은 코드와 game_version 데이터에서 관리합니다.
# 신규 게임 버전마다 환경변수를 수정할 필요가 없습니다.
NICKNAME_CHANGE_COOLDOWN=30d
TIER_AGGREGATION_INTERVAL=3m
TITLE_PENDING_TTL=30d

# 프로필 갱신과 공급자 장애 대응
PROFILE_SYNC_COOLDOWN=3m
PROFILE_CACHE_TTL=20s
PROFILE_CIRCUIT_FAILURE_THRESHOLD=3
PROFILE_CIRCUIT_OPEN_DURATION=30s

MIHOMO_USER_AGENT="StarrailHearing/0.1 contact=your-contact"
ENKA_USER_AGENT="StarrailHearing/0.1 contact=your-contact"

# Enka 트래픽/네트워크 보호값. 필요하면 숫자/시간만 바꾸고 애플리케이션을 재시작하면 됩니다.
ENKA_CONNECT_TIMEOUT=3s
ENKA_READ_TIMEOUT=15s
ENKA_CACHE_DEFAULT_TTL=60s
ENKA_CACHE_MAXIMUM_TTL=24h
ENKA_CACHE_MAX_ENTRIES=5000
ENKA_MAX_REQUESTS_PER_SECOND=2
ENKA_MAX_CONCURRENT_REQUESTS=8
ENKA_MAX_WAITING_REQUESTS=30
ENKA_REQUEST_WAIT_TIMEOUT=15s
ENKA_BACKOFF_ON_429=30s

TITLE_PRIVATE_UPLOAD_DIR=./private-uploads/title-verification
TITLE_MAXIMUM_BYTES=2097152
TITLE_MAXIMUM_REQUEST_BYTES=3145728
TITLE_MAXIMUM_DIMENSION=3200

# 서버 세션과 처리량 상한
SESSION_TIMEOUT=30m
SERVER_CONNECTION_TIMEOUT=5s
SERVER_MAX_CONNECTIONS=500
SERVER_ACCEPT_COUNT=100
SERVER_MAX_THREADS=100

# 로컬 HTTP에서는 아래 기본값을 사용합니다.
# HTTPS 프록시 뒤에 배포할 때는 각각 framework, true로 변경하세요.
SERVER_FORWARD_HEADERS_STRATEGY=none
SERVER_SERVLET_SESSION_COOKIE_SECURE=false
SPRING_THYMELEAF_CACHE=false
